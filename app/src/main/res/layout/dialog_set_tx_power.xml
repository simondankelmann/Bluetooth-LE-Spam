<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/spacing_medium">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/setTxPowerDialogTxPowerTextView"
        style="?attr/textAppearanceTitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/power_level_high"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.slider.Slider
        android:id="@+id/setTxPowerDialogSeekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:valueFrom="0.0"
        android:valueTo="3.0"
        android:stepSize="1.0"
        android:value="3.0"
        app:labelBehavior="gone"
        app:thumbColor="?attr/colorPrimary"
        app:trackColorActive="?attr/colorPrimary"
        app:trackColorInactive="?attr/colorSurfaceVariant" />

</LinearLayout>
