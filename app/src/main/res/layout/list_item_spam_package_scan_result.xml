<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/list_item_spam_package_scan_result_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:padding="@dimen/spacing_small">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/list_item_spam_package_scan_result_icon"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bluetooth"
        app:iconSize="24dp"
        app:iconTint="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/list_item_spam_package_scan_result_name"
        style="?attr/textAppearanceTitleMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toEndOf="@id/list_item_spam_package_scan_result_icon"
        app:layout_constraintEnd_toStartOf="@id/list_item_spam_package_scan_result_rssi"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/label_spam_type" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/list_item_spam_package_scan_result_address"
        style="?attr/textAppearanceBodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintStart_toEndOf="@id/list_item_spam_package_scan_result_icon"
        app:layout_constraintEnd_toStartOf="@id/list_item_spam_package_scan_result_deviceType"
        app:layout_constraintTop_toBottomOf="@id/list_item_spam_package_scan_result_name"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="@string/label_flipper_mac_address" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/list_item_spam_package_scan_result_rssi"
        style="?attr/textAppearanceBodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_small"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/list_item_spam_package_scan_result_name"
        app:layout_constraintBottom_toBottomOf="@id/list_item_spam_package_scan_result_name"
        tools:text="@string/label_rssi" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/list_item_spam_package_scan_result_deviceType"
        style="?attr/textAppearanceBodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_small"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/list_item_spam_package_scan_result_rssi"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="@string/label_flipper_device_type" />

</androidx.constraintlayout.widget.ConstraintLayout>
