<resources>

    <!-- Base application theme. -->
    <style name="Theme.BluetoothLESpam" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_normal</item>
        <item name="colorPrimaryVariant">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green_normal</item>
        <item name="colorSecondaryVariant">@color/green_dark</item>
        <item name="colorOnSecondary">@color/grey_normal</item>
        <!-- Explicit colorSurface — see values/themes.xml for rationale. Dark, neutral choice
             since the real dynamic-color background varies by device/wallpaper and can't be
             matched exactly in a static fallback. -->
        <item name="colorSurface">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="seekbarBackground">@color/grey_normal</item>
        <item name="seekbarProgress">?attr/colorPrimary</item>
        <item name="seekbarSecondaryProgress">?attr/colorPrimaryVariant</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Window/launch background — see values/themes.xml for rationale. -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <!-- Android 12+'s SplashScreen system reads THIS attr for the launch splash backdrop,
             not android:windowBackground. -->
        <item name="android:windowSplashScreenBackground">?attr/colorSurface</item>
    </style>

</resources>